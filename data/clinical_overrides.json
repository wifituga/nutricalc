  },
  "merge_rules": {
    "description": "Cuando hay múltiples comorbilidades marcadas, aplicar estas reglas para combinar overrides.",
    "rules": [
      {
        "type": "max_limit",
        "applies_to": [
          "sodio_mg",
          "fosforo_mg",
          "potasio_mg (en renales)",
          "grasa_saturada_pct_vct",
          "colesterol_mg",
          "grasa_trans_g"
        ],
        "rule": "Tomar el valor MÁS BAJO (más restrictivo)",
        "example": "DM2 sodio máx 2300 + HTA sodio máx 1500 → aplicar 1500"
      },
      {
        "type": "min_limit",
        "applies_to": [
          "fibra_g",
          "potasio_mg (en HTA)",
          "calcio_mg",
          "vitamina_c_mg",
          "vitamina_d_ug"
        ],
        "rule": "Tomar el valor MÁS ALTO (más exigente)",
        "example": "Sano fibra mín 25 + DM2 fibra mín 30 → aplicar 30"
      },
      {
        "type": "range_intersection",
        "applies_to": [
          "carbohidratos_pct_vct",
          "proteinas_pct_vct",
          "grasa_pct_vct"
        ],
        "rule": "Intersección de rangos: max(mins), min(maxs). Si resulta vacío, mostrar conflicto.",
        "example": "DM2 grasa 20-30% + HTA grasa 25-35% → resultado 25-30%"
      },
      {
        "type": "protein_g_per_kg",
        "applies_to": [
          "proteinas_g_per_kg"
        ],
        "rule": "ESPECIAL: si dos comorbilidades piden rangos no superpuestos (ej. renal 0.6-0.8 + deportista 1.2-2.0), NO auto-mergear; mostrar alerta de conflicto y mantener el valor del primer perfil marcado o el editado manualmente.",
        "example": "Renal pre-diálisis 0.6-0.8 + Deportista 1.2-2.0 → CONFLICTO, requiere decisión clínica"
      },
      {
        "type": "iron_target",
        "applies_to": [
          "hierro_mg"
        ],
        "rule": "Si Anemia activa: target = RDA base × 1.5. Si además embarazo: tomar el mayor entre (RDA embarazo × 1.5) y (RDA base × 1.5).",
        "example": "Mujer 25a anemia: 18 × 1.5 = 27 mg. Mujer 25a embarazo + anemia: 27 × 1.5 = 40.5 mg → tope UL 45 mg"
      }
    ]
  }
}